  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.4",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.14.0",
    "allure-playwright": "^3.14.0"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.3.0"
  }
}
